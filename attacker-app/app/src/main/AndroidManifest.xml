<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      ════════════════════════════════════════════════════════════════════════
      THIS BLOCK IS THE ARGUMENT. IT IS EMPTY ON PURPOSE. DO NOT ADD TO IT.

      This app declares NO permissions. That is what establishes attacker model AM-03 and it is the
      single most rating-relevant fact in any finding proved with it. Screenshot this file for the
      evidence tree. If a test genuinely needs a permission, the finding has dropped to AM-04 and must
      say so.
      ════════════════════════════════════════════════════════════════════════
    -->

    <queries>
        <!-- API 30+ package visibility: name the victim, nothing else. Also settable at runtime via
             --es victim only for Intent delivery; getPackageInfo needs this entry. -->
        <package android:name="com.victim.app" />
    </queries>

    <application
        android:label="probe"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="probe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives whatever a victim component forwards to us. -->
        <activity
            android:name=".LootActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- D04 task-affinity test (disabled by default): set taskAffinity to the victim package, then
             confirm with: adb shell dumpsys activity activities | grep -A3 'Task{' -->
        <!--
        <activity
            android:name=".HijackActivity"
            android:exported="true"
            android:taskAffinity="com.victim.app"
            android:allowTaskReparenting="true"
            android:launchMode="singleTask" />
        -->

        <!-- D05 implicit-broadcast test (disabled by default): set the action the victim sends implicitly. -->
        <!--
        <receiver android:name=".Sniffer" android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="com.victim.app.SOME_IMPLICIT_ACTION" />
            </intent-filter>
        </receiver>
        -->
    </application>
</manifest>
