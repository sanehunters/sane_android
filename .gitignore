# This repository is the methodology AND the engagement archive (BugBountyTarget/<Target>_<date>/).
# Text evidence, hashes, logs, sanitised captures and small videos are committed. Binaries never are.

# binaries and keys — never, anywhere
*.apk
*.aab
*.apks
*.xapk
*.dex
*.odex
*.oat
*.so
*.jks
*.keystore
*.p12
*.pfx

# raw captures that may hold credentials — commit the sanitised .http / .md extracts instead
*.har
*.pcap
*.pcapng

# engagement scratch that is regenerable or oversized
BugBountyTarget/*/apk/*
!BugBountyTarget/*/apk/.gitkeep
!BugBountyTarget/*/apk/versions.txt
BugBountyTarget/*/decompiled/*
!BugBountyTarget/*/decompiled/.gitkeep
state-snapshot.json

# OS / tooling noise
.DS_Store
__pycache__/
*.pyc

# standards source clones for scripts/refresh-data.py
.refs/
