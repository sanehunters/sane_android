# This repository is the methodology ONLY. It is public. Engagements (BugBountyTarget/<Target>_<DDMMYYYY>/) are
# each their own git repository — the evidence repo — created by scripts/new-engagement.sh and pushed only to a
# private remote (SANE_EVIDENCE_REMOTE). Nothing under an engagement folder is ever tracked here.
BugBountyTarget/*_*/
!BugBountyTarget/_TEMPLATE/

# binaries, keys and raw captures — never, anywhere (the same list as .claude/hooks/_lib.sh FORBIDDEN_RE)
*.apk
*.aab
*.apks
*.xapk
*.dex
*.odex
*.oat
*.so
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.crt
*.der
*.smali

# raw captures that may hold credentials — commit the sanitised .http / .md extracts instead
*.har
*.pcap
*.pcapng

# decompiled trees and tool output with full secret values — wherever they land
**/jadx_out/
**/apktool_out/
**/decompiled/
**/secrets/
secrets.csv
verify-hints.sh
sensitive/
state-snapshot.json

# tool output when $E / SANE_ENGAGEMENT is unset: tools/01–09 fall back to ./<name>/<pkg> in the cwd (tools/README 'Where outputs go')
surface-inventory/
component-sweep/
provider-sweep/
applinks/
storage-sweep/
deeplink-sweep/
deeplink-fuzz/
provider-fuzz/

# OS / tooling noise
.DS_Store
__pycache__/
*.pyc

# standards source clones for scripts/refresh-data.py
.refs/

# never commit built artefacts of the probe app
attacker-app/app/build/
attacker-app/.gradle/
attacker-app/gradle/wrapper/*.jar
